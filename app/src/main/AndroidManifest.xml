<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.mirrly.gram" />
        <package android:name="org.telegram.messenger" />
        <package android:name="com.radolyn.ayugram" />
        <package android:name="com.exteragram.messenger" />
        <package android:name="org.telegram.plus" />
        <package android:name="ir.ilmili.telegraph" />
        <package android:name="org.telegram.BifToGram" />
        <package android:name="tw.nekomimi.nekogram" />
        <package android:name="xyz.nextalone.nagram" />
        <package android:name="uz.unnarsx.cherrygram" />
        <package android:name="org.telegram.mdgram" />
        <package android:name="org.forkclient.messenger.beta" />
        <package android:name="app.nicegram" />
        <package android:name="top.qwq2333.nullgram" />
        <package android:name="com.iMe.android" />
        <package android:name="ru.dahl.messenger" />
        <package android:name="com.scriptsaz.litegram" />
        <package android:name="org.thunderdog.challegram" />
        <!-- Known proxy / VPN / local server packages for port conflict attribution -->
        <package android:name="com.v2ray.ang" />
        <package android:name="moe.nb4a" />
        <package android:name="io.nekohasekai.sagernet" />
        <package android:name="io.nekohasekai.sfa" />
        <package android:name="moe.matsuri.lite" />
        <package android:name="app.hiddify.com" />
        <package android:name="com.github.kr328.clash" />
        <package android:name="com.github.metacubed.clash.meta" />
        <package android:name="com.follow.clash" />
        <package android:name="com.getsurfboard" />
        <package android:name="io.github.dovecote.byedpi" />
        <package android:name="io.github.krlvm.powertunnel.android" />
        <package android:name="org.torproject.android" />
        <package android:name="com.github.shadowsocks" />
        <package android:name="org.outline.android.client" />
        <package android:name="com.nebula.karing" />
        <package android:name="com.happproxy" />
        <package android:name="com.adguard.android" />
        <package android:name="com.celzero.bravedns" />
        <package android:name="app.intra" />
        <package android:name="org.amnezia.vpn" />
        <package android:name="org.amnezia.awg" />
        <package android:name="com.wireguard.android" />
        <package android:name="com.evozi.injector" />
        <package android:name="com.termux" />
        <package android:name="com.mirrly.tgproxy.debug" />
        <package android:name="com.mirrly.tgproxy.beta" />
        <!-- OEM startup and background managers for autostart deep-linking on Android 11+ -->
        <package android:name="com.hihonor.systemmanager" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.miui.powerkeeper" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oplus.safecenter" />
        <package android:name="com.oplus.battery" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.iqoo.secure" />
        <package android:name="com.letv.android.letvsafe" />
    </queries>

    <application
        android:name=".MirrlyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher_default"
        android:roundIcon="@mipmap/ic_launcher_default"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Mirrly">

        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:hardwareAccelerated="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Mirrly">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>

            <!-- Deep Link: mirrly://worker?domain=...&name=... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="mirrly"
                    android:host="worker" />
            </intent-filter>

            <!-- Deep Link: mirrly://oauth (Return from Cloudflare OAuth callback) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="mirrly"
                    android:host="oauth" />
                <data
                    android:scheme="mirrly"
                    android:host="cloudflare" />
            </intent-filter>

            <!-- Android App Links: https://mirrly.app/worker or https://mirrly.app/oauth -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="mirrly.app" />
                <data android:host="www.mirrly.app" />
                <data android:host="mirrly.me" />
                <data android:host="www.mirrly.me" />
                <data android:pathPrefix="/worker" />
                <data android:pathPrefix="/oauth" />
                <data android:path="/" />
            </intent-filter>
        </activity>

        <!-- Dynamic Launcher Icon Aliases (MAIN / LAUNCHER entry points) -->
        <activity-alias
            android:name="com.mirrly.tgproxy.LauncherIconDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_default"
            android:roundIcon="@mipmap/ic_launcher_default"
            android:label="${appLabel}"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.mirrly.tgproxy.LauncherIconLegacy"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_legacy"
            android:roundIcon="@mipmap/ic_launcher_legacy"
            android:label="${appLabel}"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.mirrly.tgproxy.LauncherIconOutline"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_outline"
            android:roundIcon="@mipmap/ic_launcher_outline"
            android:label="${appLabel}"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.mirrly.tgproxy.LauncherIconStealth"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_stealth"
            android:roundIcon="@mipmap/ic_launcher_stealth"
            android:label="${appLabel}"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.mirrly.tgproxy.LauncherIconRuby"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ruby"
            android:roundIcon="@mipmap/ic_launcher_ruby"
            android:label="${appLabel}"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.mirrly.tgproxy.LauncherIconCobalt"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cobalt"
            android:roundIcon="@mipmap/ic_launcher_cobalt"
            android:label="${appLabel}"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.mirrly.tgproxy.LauncherIconAmber"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_amber"
            android:roundIcon="@mipmap/ic_launcher_amber"
            android:label="${appLabel}"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.mirrly.tgproxy.LauncherIconViolet"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_violet"
            android:roundIcon="@mipmap/ic_launcher_violet"
            android:label="${appLabel}"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".service.ProxyForegroundService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local socks5 and mtproto proxy server for background network routing and messenger connectivity" />
        </service>

        <service
            android:name=".service.MirrlyVpnService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="systemExempted|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="System-wide VPN tunnel network routing via Cloudflare Anycast" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <service
            android:name=".service.ProxyTileService"
            android:exported="true"
            android:label="@string/tile_proxy_label"
            android:icon="@drawable/ic_qs_proxy"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".service.VpnTileService"
            android:exported="true"
            android:label="@string/tile_vpn_label"
            android:icon="@drawable/ic_qs_warp_inactive"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".service.ScheduleReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.mirrly.tgproxy.SCHEDULE_START" />
                <action android:name="com.mirrly.tgproxy.SCHEDULE_STOP" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIME_CHANGED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".service.ProxyResurrectionReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.mirrly.tgproxy.ACTION_RESURRECT_PROXY" />
                <action android:name="com.mirrly.tgproxy.ACTION_WATCHDOG_HEARTBEAT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".service.MirrlyBridgeReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.mirrly.tgproxy.BRIDGE_CMD" />
                <action android:name="com.mirrly.tgproxy.QUERY_STATUS" />
            </intent-filter>
        </receiver>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
