# Mirrly TG Proxy - Release Signing Configuration Example
# Copy this file to 'keystore.properties' and fill in your actual keystore credentials.
# NEVER commit 'keystore.properties' or keystore files (*.jks / *.keystore) into Git!

storeFile=release.jks
storePassword=your_keystore_password_here
keyAlias=your_key_alias_here
keyPassword=your_key_password_here
